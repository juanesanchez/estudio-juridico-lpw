# ---------------------------------------------------------------------------
# Medicion (Google Tag Manager / Google Ads / GA4)
#
# Copiar este archivo a .env.local y completar los valores.
# Mientras esten vacios el sitio NO carga ningun script de Google.
# En produccion (Vercel) se cargan desde Settings > Environment Variables.
#
# Detalle completo del setup en docs/google-ads-tracking.md
# ---------------------------------------------------------------------------

# MODO EN USO: contenedor de Google Tag Manager. Formato: GTM-XXXXXXX
# Las etiquetas de GA4 y de conversiones de Ads se configuran dentro de GTM,
# sin tocar el codigo del sitio.
NEXT_PUBLIC_GTM_ID=

# ---------------------------------------------------------------------------
# Alternativa: gtag.js directo, sin GTM. Hoy no se usa.
# Solo completar si alguna vez se decide prescindir de Tag Manager.
# Los dos modos pueden convivir, pero cuidado con contar dos veces la misma
# conversion si GTM ya dispara la etiqueta de Ads.
# ---------------------------------------------------------------------------

# Google Ads > Objetivos > Conversiones > Configuracion de etiqueta. Ej: AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Analytics > Administrar > Flujos de datos > Web. Ej: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Etiquetas de conversion de Ads, solo para el modo gtag.js directo.
# Ads entrega un send_to 'AW-123456789/AbC-D_efGh1jk': aca va SOLO lo que sigue
# despues de la barra.
NEXT_PUBLIC_ADS_LABEL_CHATBOT_LEAD=
NEXT_PUBLIC_ADS_LABEL_CONTACT_FORM_LEAD=
NEXT_PUBLIC_ADS_LABEL_WHATSAPP_CLICK=
NEXT_PUBLIC_ADS_LABEL_PHONE_CLICK=
